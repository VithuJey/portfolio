---
import CopyEmailButton from '@/components/ui/CopyEmailButton.astro'
import { portfolio } from '@/lib/portfolio'
const { socials, footer, email } = portfolio
---

<div class='footer'>
	<div class='social-list'>
		{
			socials
				.filter((social) => social.visible)
				.map((social) => (
					<a href={social.url} target='_blank' rel='noopener noreferrer'>
						<img
							class='social-icons'
							src={social.icon}
							alt={social.alt}
							height='22px'
						/>
					</a>
				))
		}
	</div>
	<div class='email-line'>
		<a class='email-link' href={`mailto:${email}`}>{email}</a>
		<CopyEmailButton tooltip='top' />
	</div>
	<p>{footer.builtWithText}</p>
	<a href={footer.builtWithUrl} target='_blank' rel='noopener noreferrer'
		><img
			class='built-with-logo'
			src={footer.builtWithLogo}
			alt={footer.builtWithAlt}
			height='40px'
		/>
	</a>
</div>

<style>
	.footer {
		margin-bottom: 20px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.footer > * {
		margin-bottom: 20px;
	}
	.social-list,
	.email-line {
		display: none;
	}
	.email-link {
		overflow-wrap: anywhere;
	}
	p,
	a {
		font-family: var(--font-mono);
		font-size: var(--font-sm);
		color: var(--tertiary-color);
		text-align: center;
		text-decoration: none;
	}
	a:hover {
		color: var(--secondary-color);
	}
	.built-with-logo {
		filter: var(--social-icon-filter);
	}
	@media only screen and (max-width: 768px) {
		.social-list {
			display: block;
			text-align: center;
		}
		.social-list a {
			margin: 0 18px;
		}
		.email-line {
			display: flex;
			align-items: center;
			justify-content: center;
			flex-wrap: wrap;
			gap: 4px 8px;
		}
		.social-icons {
			filter: var(--social-icon-filter);
		}
	}
</style>
