---
import { portfolio } from '@/lib/portfolio'
const { heading, description, buttonUrl, buttonText, copyLabel, copiedLabel } =
	portfolio.contact
const { email } = portfolio
---

<section id='contact'>
	<div class='content'>
		<h2>{heading}</h2>
		<p>{description}</p>
		<a class='contact-button' href={buttonUrl}>
			{buttonText}
			<span class='hi-emoji'>👋</span>
		</a>
		<div class='email-row'>
			<a class='email-link' href={`mailto:${email}`}>{email}</a>
			<button
				type='button'
				class='copy-button'
				data-email={email}
				data-copied-label={copiedLabel}
				data-label={copyLabel}
			>
				{copyLabel}
			</button>
			<span class='sr-only' role='status' aria-live='polite' id='copy-status'
			></span>
		</div>
	</div>
</section>

<script>
	const button = document.querySelector<HTMLButtonElement>('.copy-button')
	const status = document.getElementById('copy-status')

	async function copyText(text: string) {
		if (navigator.clipboard?.writeText) {
			await navigator.clipboard.writeText(text)
			return
		}
		const area = document.createElement('textarea')
		area.value = text
		area.setAttribute('readonly', '')
		area.style.position = 'fixed'
		area.style.opacity = '0'
		document.body.appendChild(area)
		area.select()
		const ok = document.execCommand('copy')
		area.remove()
		if (!ok) throw new Error('copy failed')
	}

	button?.addEventListener('click', async () => {
		const label = button.dataset.label ?? 'Copy email'
		const copied = button.dataset.copiedLabel ?? 'Copied!'
		try {
			await copyText(button.dataset.email ?? '')
			button.textContent = copied
			button.classList.add('copy-button--done')
			if (status) status.textContent = copied
		} catch {
			button.textContent = 'Press Ctrl+C'
		}
		setTimeout(() => {
			button.textContent = label
			button.classList.remove('copy-button--done')
			if (status) status.textContent = ''
		}, 2000)
	})
</script>

<style>
	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.content > * {
		margin-bottom: 10px;
	}
	h2 {
		font-family: var(--font-sans);
		font-size: clamp(40px, 5vw, 60px);
		color: var(--primary-color);
	}
	.content p {
		text-align: center;
	}
	.contact-button {
		font-family: var(--font-mono);
		font-size: var(--font-md);
		line-height: var(--line-height-md);
		color: var(--secondary-color);
		background-color: transparent;
		border-radius: 50px;
		border: 2px solid var(--secondary-color);
		padding: 0.5rem 1.5rem;
		margin: 30px 0;
		text-decoration: none;
		display: inline-block;
		transition:
			background-color 0.25s ease,
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.contact-button:hover {
		background-color: var(--active-color);
		transform: translateY(-2px);
		box-shadow: 0 5px 15px rgba(6, 147, 227, 0.25);
	}
	.email-row {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}
	.email-link {
		font-family: var(--font-mono);
		font-size: var(--font-sm);
		color: var(--tertiary-color);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.email-link:hover,
	.email-link:focus-visible {
		color: var(--primary-color);
		text-decoration: underline;
	}
	.copy-button {
		font-family: var(--font-mono);
		font-size: var(--font-xs);
		line-height: var(--line-height-xs);
		letter-spacing: 0.04em;
		color: var(--primary-color);
		background-color: transparent;
		border: 1px solid var(--tertiary-color);
		border-radius: 6px;
		padding: 4px 10px;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}
	.copy-button:hover,
	.copy-button:focus-visible {
		background-color: var(--active-color);
		border-color: var(--secondary-color);
	}
	.copy-button--done {
		border-color: #22c55e;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.hi-emoji {
		display: inline-block;
		transform-origin: 70% 70%;
		transition: transform 0.3s ease;
	}
	.contact-button:hover .hi-emoji {
		animation: wave-animation 1.2s infinite;
	}

	@keyframes wave-animation {
		0% {
			transform: rotate(0deg);
		}
		10% {
			transform: rotate(14deg);
		}
		20% {
			transform: rotate(-8deg);
		}
		30% {
			transform: rotate(14deg);
		}
		40% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(10deg);
		}
		60% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(0deg);
		}
	}
</style>
