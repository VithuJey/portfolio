---
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { portfolio } from '@/lib/portfolio'
const { heading, list } = portfolio.insights

const typeIcons: Record<string, { svg: string; label: string }> = {
	article: {
		svg: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
		label: 'Article',
	},
	video: {
		svg: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>',
		label: 'Video',
	},
}

const getYoutubeThumbnail = (url: string) => {
	const match = url.match(
		/(?:youtube\.com\/(?:watch\?v=|shorts\/)|youtu\.be\/)([^&\n?#]+)/
	)

	return match ? `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg` : url
}
---

<section id='insights'>
	<SectionHeading title={heading} />

	<div class='insights-grid'>
		{
			list.map((item) => {
				const icon = typeIcons[item.type] || typeIcons.article
				const isShort = item.link.includes('/shorts/')
				return (
					<a
						class:list={['insight-tile', { 'is-short': isShort }]}
						href={item.link}
						target='_blank'
						rel='noopener noreferrer'
					>
						<div class='tile-thumbnail'>
							{isShort ? (
								<>
									<div class='short-frame'>
										<img
											src={getYoutubeThumbnail(item.thumbnail)}
											alt={item.title}
											loading='lazy'
										/>
									</div>
									<span class='short-play' aria-hidden='true'>
										<svg
											width='14'
											height='14'
											viewBox='0 0 24 24'
											fill='currentColor'
										>
											<polygon points='6 3 20 12 6 21' />
										</svg>
									</span>
									<span class='short-tag'>Short</span>
								</>
							) : (
								<img
									src={getYoutubeThumbnail(item.thumbnail)}
									alt={item.title}
									loading='lazy'
								/>
							)}
							<span class='type-badge' title={icon.label}>
								<Fragment set:html={icon.svg} />
							</span>
						</div>
						<div class='tile-content'>
							<p class='tile-title'>{item.title}</p>
							<p class='tile-desc'>{item.desc}</p>
						</div>
					</a>
				)
			})
		}
	</div>
</section>

<style>
	.insights-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		margin-top: 40px;
	}

	.insight-tile {
		background-color: var(--card-color);
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
		box-shadow: var(--card-shadow);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.insight-tile:hover {
		transform: translateY(-5px);
		box-shadow: var(--card-shadow-hover);
	}

	.tile-thumbnail {
		width: 100%;
		height: 180px;
		overflow: hidden;
		position: relative;
	}

	.tile-thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.insight-tile:hover .tile-thumbnail img {
		transform: scale(1.05);
	}

	/* Shorts are vertical: show the video frame centered on a gradient instead of stretching it across the wide card */
	.is-short .tile-thumbnail {
		background: linear-gradient(135deg, var(--secondary-color) 0%, #151d35 70%);
	}

	.short-frame {
		position: absolute;
		top: 14px;
		bottom: 14px;
		left: 50%;
		width: 79px;
		transform: translateX(-50%);
		overflow: hidden;
		border-radius: 8px;
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
	}

	/* hqdefault is 4:3 with the vertical video pillarboxed in the middle; the narrow frame crops the bars away */
	.tile-thumbnail .short-frame img {
		position: absolute;
		left: 50%;
		width: auto;
		max-width: none;
		transform: translateX(-50%);
	}

	.insight-tile:hover .tile-thumbnail .short-frame img {
		transform: translateX(-50%) scale(1.05);
	}

	.short-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
		transform: translate(-50%, -50%);
	}

	.short-tag {
		position: absolute;
		right: 10px;
		bottom: 10px;
		padding: 3px 8px;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.55);
		color: #fff;
		font-family: var(--font-sans);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.type-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		color: var(--secondary-color);
	}

	.tile-content {
		padding: 20px;
	}

	.tile-title {
		font-family: var(--font-sans);
		font-size: var(--font-lg);
		font-weight: 600;
		line-height: var(--line-height-lg);
		color: var(--primary-color);
		margin: 0 0 8px 0;
	}

	.tile-desc {
		font-family: var(--font-sans);
		font-size: var(--font-sm);
		line-height: var(--line-height-sm);
		color: var(--tertiary-color);
		margin: 0;
	}

	@media only screen and (max-width: 768px) {
		.insights-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}

	@media only screen and (min-width: 769px) and (max-width: 1024px) {
		.insights-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
