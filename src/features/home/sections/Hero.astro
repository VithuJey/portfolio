---
import { portfolio } from '@/lib/portfolio'
const {
	welcome,
	name,
	subtitle,
	description,
	resumeUrl,
	resumeLabel,
	currently,
	scrollLabel,
} = portfolio.hero
---

<div class='hero'>
	<div class='glow-bg'></div>
	<div class='hero-content'>
		<p class='welcome'>{welcome}</p>
		<h1>{name}</h1>
		<p class='subtitle'>{subtitle}</p>
		<p>{description}</p>
		<a
			href={resumeUrl}
			target='_blank'
			class='resume-button'
			data-track='resume-download'
		>
			{resumeLabel}
		</a>
		<p class='currently'>
			<span class='currently-dot' aria-hidden='true'></span>
			<span class='currently-label'>{currently.label}:</span>
			{currently.text}
		</p>
	</div>
	<a class='scroll-cue' href='#about' aria-label={scrollLabel}>
		<span class='scroll-cue-text'>{scrollLabel}</span>
		<svg
			class='scroll-cue-icon'
			xmlns='http://www.w3.org/2000/svg'
			width='20'
			height='20'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
		>
			<path d='m6 9 6 6 6-6'></path>
		</svg>
	</a>
</div>

<style>
	.hero {
		display: flex;
		justify-content: center;
		flex-direction: column;
		align-items: flex-start;
		min-height: calc(100vh - calc(var(--header-height) * 2));
		min-height: 100vh;
		position: relative;
	}
	.glow-bg {
		position: absolute;
		top: 25%;
		left: 15%;
		width: min(400px, 70vw);
		height: min(400px, 70vw);
		background: radial-gradient(
			circle,
			rgba(99, 102, 241, 0.15) 0%,
			rgba(6, 147, 227, 0.05) 50%,
			rgba(0, 0, 0, 0) 70%
		);
		filter: blur(60px);
		z-index: 1;
		pointer-events: none;
		animation: pulse-glow 8s infinite alternate ease-in-out;
	}
	.hero-content {
		position: relative;
		z-index: 2;
	}
	/* Staggered entrance; `backwards` fill keeps final styles/hover untouched. */
	.hero-content > * {
		animation: hero-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
	}
	.hero-content > :nth-child(2) {
		animation-delay: 90ms;
	}
	.hero-content > :nth-child(3) {
		animation-delay: 180ms;
	}
	.hero-content > :nth-child(4) {
		animation-delay: 270ms;
	}
	.hero-content > :nth-child(5) {
		animation-delay: 360ms;
	}
	.hero-content > :nth-child(6) {
		animation-delay: 450ms;
	}
	.scroll-cue {
		animation: hero-fade 1s ease 1s backwards;
	}
	@keyframes hero-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes hero-fade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@keyframes pulse-glow {
		0% {
			transform: scale(1) translate(0, 0);
			opacity: 0.8;
		}
		100% {
			transform: scale(1.15) translate(5%, 5%);
			opacity: 1;
		}
	}
	.welcome {
		margin: 2.33em 0;
		font-weight: 700;
		font-family: var(--font-mono);
		font-size: var(--font-md);
		line-height: var(--line-height-md);
		color: var(--secondary-color);
	}
	h1,
	.subtitle {
		font-family: var(--font-sans);
		font-size: clamp(40px, 8vw, 80px);
		font-weight: 550;
		line-height: 0.9;
		color: var(--primary-color);
		margin: 0;
	}
	h1 {
		color: var(--primary-color);
		font-weight: 600;
	}
	.subtitle {
		color: var(--secondary-color);
		margin: 30px 0;
		max-width: none;
	}
	p {
		margin: 20px 0;
		max-width: 500px;
	}
	.resume-button {
		font-family: var(--font-mono);
		font-size: var(--font-md);
		line-height: var(--line-height-md);
		color: var(--secondary-color);
		text-decoration: none;
		background-color: transparent;
		border-radius: 50px;
		border: 2px solid var(--secondary-color);
		padding: 0.5rem 1.5rem;
		margin: 30px 0;
		display: inline-block;
		transition:
			background-color 0.25s ease,
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.currently {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 8px;
		margin: 0;
		max-width: 520px;
		font-size: var(--font-sm);
		line-height: var(--line-height-sm);
	}
	.currently-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: #22c55e;
		align-self: center;
		flex-shrink: 0;
		animation: dot-pulse 2s infinite ease-in-out;
	}
	.currently-label {
		font-family: var(--font-mono);
		font-size: var(--font-sm);
		color: var(--primary-color);
	}
	@keyframes dot-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
		}
		50% {
			box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
		}
	}
	.scroll-cue {
		position: absolute;
		bottom: 28px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		color: var(--tertiary-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.scroll-cue:hover,
	.scroll-cue:focus-visible {
		color: var(--secondary-color);
	}
	.scroll-cue-text {
		font-family: var(--font-mono);
		font-size: var(--font-xs);
		line-height: var(--line-height-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: inherit;
	}
	.scroll-cue-icon {
		animation: cue-bounce 1.8s infinite ease-in-out;
	}
	@keyframes cue-bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}
	.resume-button:hover {
		background-color: var(--active-color);
		transform: translateY(-2px);
		box-shadow: 0 5px 15px rgba(6, 147, 227, 0.25);
	}
</style>
