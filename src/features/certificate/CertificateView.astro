---
import { Image } from 'astro:assets'
import { resolveImage } from '@/lib/images'

interface Props {
	imgSrc: string
	imgAlt: string
}

const { imgSrc, imgAlt } = Astro.props
---

<section id='certificate'>
	<div class='wrapper'>
		<Image src={resolveImage(imgSrc)} alt={imgAlt} width={1600} />
	</div>
</section>
