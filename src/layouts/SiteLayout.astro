---
import EmailRail from '@/components/layout/EmailRail.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import SocialRail from '@/components/layout/SocialRail.astro'
import SeoHead from '@/components/seo/SeoHead.astro'
import '@/styles/global.css'

interface Props {
	title: string
	contentClass?: string
	showHeader?: boolean
	noindex?: boolean
	personSchema?: boolean
}

const {
	title,
	contentClass,
	showHeader = true,
	noindex = false,
	personSchema = false,
} = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		<SeoHead title={title} noindex={noindex} personSchema={personSchema} />
	</head>
	<body>
		<a class='skip-link' href='#content'>Skip to content</a>
		{showHeader && <SiteHeader />}
		<main id='content' class:list={contentClass}>
			<slot />
		</main>
		<SocialRail />
		<EmailRail />
		<style>
			.skip-link {
				position: fixed;
				top: 8px;
				left: 8px;
				z-index: 1000;
				padding: 0.5rem 1rem;
				font-family: var(--font-mono);
				color: var(--bg-color);
				background-color: var(--secondary-color);
				border-radius: 4px;
				text-decoration: none;
				transform: translateY(-200%);
			}
			.skip-link:focus {
				transform: translateY(0);
			}
			#content {
				margin: auto;
				padding: 0 25px;
				max-width: 1600px;
				min-height: calc(100vh - 5em);
			}
			@media only screen and (min-width: 768px) {
				#content {
					padding: 0 50px;
				}
			}
			@media only screen and (min-width: 992px) {
				#content {
					padding: 0 130px;
				}
				#content.content--cert {
					padding: 0 80px;
				}
			}
			@media only screen and (min-width: 1440px) {
				#content {
					padding: 0 250px;
				}
			}
			@media only screen and (min-width: 1920px) {
				#content {
					padding: 0 450px;
				}
			}
			@media only screen and (min-width: 2560px) {
				#content {
					padding: 0 650px;
					max-width: 1200px;
				}
			}
		</style>
	</body>
</html>
