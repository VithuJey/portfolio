---
import BackToTop from '@/components/layout/BackToTop.astro'
import EmailRail from '@/components/layout/EmailRail.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import SocialRail from '@/components/layout/SocialRail.astro'
import SeoHead from '@/components/seo/SeoHead.astro'
import '@/styles/global.css'

interface Props {
	title: string
	contentClass?: string
	showHeader?: boolean
	noindex?: boolean
	personSchema?: boolean
}

const {
	title,
	contentClass,
	showHeader = true,
	noindex = false,
	personSchema = false,
} = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		<SeoHead title={title} noindex={noindex} personSchema={personSchema} />
	</head>
	<body>
		<a class='skip-link' href='#content'>Skip to content</a>
		{showHeader && <SiteHeader />}
		<main id='content' class:list={contentClass}>
			<slot />
		</main>
		<SocialRail />
		<EmailRail />
		<BackToTop />
		<script>
			// Fade sections and cards in as they scroll into view.
			const targets = document.querySelectorAll<HTMLElement>(
				'main section:not(#certificate), .insight-tile'
			)
			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible')
								observer.unobserve(entry.target)
							}
						})
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
				)
				targets.forEach((el) => {
					el.classList.add('reveal')
					observer.observe(el)
				})
			}

			// Analytics hook: elements with data-track fire an event on click.
			// Works with Plausible, Umami or GA if one is added later; no-op otherwise.
			document.addEventListener('click', (event) => {
				const el = (event.target as HTMLElement).closest<HTMLElement>(
					'[data-track]'
				)
				if (!el) return
				const name = el.dataset.track as string
				const w = window as unknown as Record<string, any>
				w.plausible?.(name)
				w.umami?.track?.(name)
				w.gtag?.('event', name)
				document.dispatchEvent(
					new CustomEvent('portfolio:track', { detail: name })
				)
			})
		</script>
		<style>
			.skip-link {
				position: fixed;
				top: -100px;
				left: 8px;
				z-index: 1000;
				padding: 0.5rem 1rem;
				font-family: var(--font-mono);
				color: var(--bg-color);
				background-color: var(--secondary-color);
				border-radius: 4px;
				text-decoration: none;
			}
			.skip-link:focus {
				top: 8px;
			}
			#content {
				margin: auto;
				padding: 0 25px;
				max-width: 1600px;
				min-height: calc(100vh - 5em);
			}
			@media only screen and (min-width: 768px) {
				#content {
					padding: 0 50px;
				}
			}
			@media only screen and (min-width: 992px) {
				#content {
					padding: 0 130px;
				}
				#content.content--cert {
					padding: 0 80px;
				}
			}
			@media only screen and (min-width: 1440px) {
				#content {
					padding: 0 250px;
				}
			}
			@media only screen and (min-width: 1920px) {
				#content {
					padding: 0 450px;
				}
			}
			@media only screen and (min-width: 2560px) {
				#content {
					padding: 0 650px;
					max-width: 1200px;
				}
			}
		</style>
	</body>
</html>
