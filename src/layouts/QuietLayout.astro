---
import '@fontsource-variable/inter'
import SeoHead from '@/components/seo/SeoHead.astro'

interface Props {
	title: string
	noindex?: boolean
}

const { title, noindex = false } = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		<SeoHead title={title} noindex={noindex} themeMode='system' fonts={false} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #fcfcfb;
		--fg: #1a1a1a;
		--muted: #5f5f5f;
		--muted-soft: #6b6b6b;
		--link: #333333;
		--accent: #0467ad;
	}

	:root[data-theme='dark'] {
		color-scheme: dark;
		--bg: #0a0f1e;
		--fg: #f4f6fb;
		--muted: #98a2c6;
		--muted-soft: #98a2c6;
		--link: #c9d0e8;
		--accent: #0693e3;
	}

	html {
		background: var(--bg);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--muted);
		font-family:
			'Inter Variable',
			system-ui,
			-apple-system,
			'Segoe UI',
			Roboto,
			sans-serif;
		font-size: 16px;
		line-height: 26px;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
