---
import CopyEmailButton from '@/components/ui/CopyEmailButton.astro'
import QuietLayout from '@/layouts/QuietLayout.astro'
import { isHomeSectionVisible } from '@/lib/nav'
import { portfolio } from '@/lib/portfolio'
import { site } from '@/lib/site'

const { hero, quiet, experience, projects, insights, socials, email } =
	portfolio

// "Mar 2025 - Present" -> "Mar 2025 to present"
const dates = (duration: string) =>
	duration.replace(' - ', ' to ').replace('Present', 'present')

// Featured items first, then the rest in their original order.
const writing = [
	...insights.list.filter((item) => item.featured),
	...insights.list.filter((item) => !item.featured),
]

const social = (id: string) =>
	socials.find((item) => item.id === id && item.visible)
const medium = social('medium')
const github = social('github')
const linkedin = social('linkedin')

// Projects stay hidden until the Projects section is switched on in the data.
const showProjects = isHomeSectionVisible('Projects')
---

<QuietLayout title={site.author} noindex>
	<header class='intro'>
		<a
			class='logo'
			href={Astro.url.pathname}
			aria-label={`${site.author}, home`}
		>
			<img src='/icons/logo.svg' alt='' width='32' height='32' />
		</a>
		<h1>{site.author}</h1>
		<p class='role'>{hero.subtitle}</p>
	</header>

	<main class='page'>
		<section>
			<h2>Today</h2>
			<p>{quiet.today}</p>
		</section>

		{
			showProjects && (
				<section>
					<h2>{projects.heading}</h2>
					<div class='list'>
						{projects.list.map((project) => (
							<a
								class='item'
								href={project.links[0]?.url ?? '#'}
								target='_blank'
								rel='noopener noreferrer'
							>
								<span class='title'>{project.title}</span>
								<span class='desc'>{project.description}</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		<section>
			<h2>{experience.heading}</h2>
			<div class='list'>
				{
					experience.jobs.map((job) => (
						<div class='item'>
							<span class='title'>
								{job.role}, {job.company}
							</span>
							<span class='desc'>
								{dates(job.duration)}. {job.summary}
							</span>
						</div>
					))
				}
			</div>
		</section>

		<section>
			<h2>{insights.heading}</h2>
			<div class='list'>
				{
					writing.map((item) => (
						<a
							class='item'
							href={item.link}
							target='_blank'
							rel='noopener noreferrer'
						>
							<span class='title'>
								{item.title}
								{item.type === 'video' && <span class='kind'> (video)</span>}
							</span>
							<span class='desc'>{item.desc}</span>
						</a>
					))
				}
			</div>
		</section>

		<section>
			<h2>More</h2>
			<p>
				You can read my <a class='u' href={hero.resumeUrl} target='_blank'
					>resume</a
				>{
					medium && (
						<>
							, find more writing on{' '}
							<a
								class='u'
								href={medium.url}
								target='_blank'
								rel='noopener noreferrer'
							>
								Medium
							</a>
						</>
					)
				}{
					github && (
						<>
							, and more code on{' '}
							<a
								class='u'
								href={github.url}
								target='_blank'
								rel='noopener noreferrer'
							>
								GitHub
							</a>
						</>
					)
				}.{
					linkedin && (
						<>
							{' '}
							I'm also on{' '}
							<a
								class='u'
								href={linkedin.url}
								target='_blank'
								rel='noopener noreferrer'
							>
								LinkedIn
							</a>
							.
						</>
					)
				}
			</p>
			<p class='email'>
				Email me at <a class='u' href={`mailto:${email}`}>{email}</a>
				<CopyEmailButton tooltip='top' size={44} />
			</p>
			<p>
				<button type='button' class='theme-switch' id='theme-switch'
					>Switch to dark mode</button
				>
			</p>
		</section>
	</main>
</QuietLayout>

<script>
	const root = document.documentElement
	const button = document.getElementById('theme-switch')

	function current(): 'light' | 'dark' {
		return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'
	}

	function label() {
		if (button) {
			button.textContent =
				current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
		}
	}

	button?.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark'
		root.setAttribute('data-theme', next)
		try {
			localStorage.setItem('theme', next)
		} catch {
			// storage unavailable; the choice still applies for this visit
		}
		label()
	})

	label()
</script>

<style>
	.intro,
	.page {
		box-sizing: border-box;
		width: 100%;
		max-width: 648px;
		margin: 0 auto;
		padding-inline: 24px;
	}

	.intro {
		padding-top: 96px;
	}

	.page {
		padding-bottom: 120px;
	}

	.logo {
		display: block;
		width: 32px;
		height: 32px;
		margin-bottom: 28px;
	}

	.logo img {
		display: block;
	}

	h1,
	h2 {
		margin: 0;
		font-size: 16px;
		line-height: 24px;
		font-weight: 500;
		color: var(--fg);
	}

	.role {
		margin: 0;
		line-height: 24px;
	}

	section {
		margin-top: 72px;
	}

	section p {
		margin: 16px 0 0;
	}

	.list {
		margin-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.item {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.title {
		display: block;
		color: var(--fg);
		font-weight: 500;
	}

	.kind {
		font-weight: 400;
		color: var(--muted-soft);
	}

	.desc {
		display: block;
	}

	a.item:hover .title,
	a.item:focus-visible .title {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.u {
		color: var(--link);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.u:hover {
		color: var(--fg);
	}

	.email {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 6px;
	}

	.email :global(.copy-wrap) {
		margin-block: -10px;
	}

	.email :global(.copy-btn) {
		color: var(--muted);
	}

	.email :global(.copy-btn:hover),
	.email :global(.copy-btn:focus-visible) {
		color: var(--accent);
		border-color: var(--accent);
	}

	.theme-switch {
		min-height: 44px;
		margin: -10px 0;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		color: var(--muted);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		cursor: pointer;
	}

	.theme-switch:hover {
		color: var(--fg);
	}

	@media only screen and (max-width: 480px) {
		.intro {
			padding-top: 56px;
		}
		section {
			margin-top: 56px;
		}
		.list {
			gap: 24px;
		}
	}
</style>
